@foreach (var pizza in Order.Pizzas)
{
	<p>
		<strong>
			@(pizza.Size)"
			@pizza.Special.Name
			(<span class="price">@pizza.GetFormattedTotalPrice()</span>)
		</strong>
	</p>
}
<p>
	<strong>
		Total price:
		<span class="price">@Order.GetFormattedTotalPrice()</span>
	</strong>
</p>
@code
{
	[Parameter] public Order Order { get; set; }
}